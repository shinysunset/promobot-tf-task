<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>promobot_tf_library</name>
  <version>0.1.0</version>
  <description>Coordinate transformation library for Promobot task (ROS2 Jazzy)</description>
  <maintainer email="shinysunset@todo.todo">shinysunset</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Основные зависимости -->
  <depend>yaml-cpp</depend>  <!-- Зависимость от системного yaml-cpp -->
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend> <!-- Для регистрации ноды как компонента -->
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>rcl_interfaces</depend> <!-- Для SetParametersResult и ParameterDescriptor -->
  <depend>ament_index_cpp</depend> <!-- Для поиска пути к файлу transforms.yaml -->


  <!-- Зависимости для тестов -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
